---
import PageLayout from "../../layouts/PageLayout.astro";
import ResearchHero from "../../components/research/ResearchHero.astro";
import ToolList from "../../components/tools/ToolList.astro";
import { getLangFromUrl, t } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
---

<PageLayout title={`${t(lang, "tools.title")} — Luis Sarmiento`}>
  <ResearchHero
    title={t(lang, "tools.title")}
    description={t(lang, "tools.description")}
  />
  <section class="py-20 px-4 bg-warm-gray">
    <div class="max-w-4xl mx-auto">
      <ToolList />
    </div>
  </section>
</PageLayout>
