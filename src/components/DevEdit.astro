---
/**
 * Dev-only text editing overlay. Rendered by BaseLayout only when
 * import.meta.env.DEV, so it never reaches the built site.
 *
 *   Cmd+Shift+E   toggle edit mode (every text leaf becomes editable)
 *   Cmd+S         save all edited leaves to their source files
 *   Esc           leave edit mode, discarding unsaved edits
 *
 * Saving POSTs {before, after} to /__dev-edit (tools/dev-edit-plugin.mjs),
 * which rewrites the matching string in src/. Text assembled from
 * interpolated values cannot be located and is reported as such.
 */
---

<div id="dev-edit-bar" hidden>
  <span id="dev-edit-status">Edit mode · click any text · ⌘S saves · Esc cancels</span>
  <button type="button" id="dev-edit-save">Save (⌘S)</button>
  <button type="button" id="dev-edit-cancel">Cancel (Esc)</button>
</div>

<style>
  #dev-edit-bar {
    position: fixed;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    z-index: 99999;
    display: flex;
    gap: 10px;
    align-items: center;
    background: #111827;
    color: #f9fafb;
    font: 13px/1.3 system-ui, sans-serif;
    padding: 8px 12px;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    max-width: 90vw;
  }
  #dev-edit-bar button {
    background: #374151;
    color: inherit;
    border: 0;
    border-radius: 5px;
    padding: 4px 9px;
    cursor: pointer;
  }
  #dev-edit-bar button:hover { background: #4b5563; }
  :global(.dev-edit-leaf) {
    outline: 1px dashed rgba(37, 99, 235, 0.45);
    outline-offset: 2px;
    cursor: text;
  }
  :global(.dev-edit-leaf:focus) { outline: 2px solid #2563eb; }
  :global(.dev-edit-dirty) { background: rgba(250, 204, 21, 0.25); }
  :global(.dev-edit-error) { outline: 2px solid #dc2626 !important; }
</style>

<script>
  const bar = document.getElementById("dev-edit-bar")!;
  const status = document.getElementById("dev-edit-status")!;
  let on = false;
  const original = new Map<HTMLElement, string>();

  const SKIP = new Set(["SCRIPT", "STYLE", "SVG", "CODE", "PRE", "INPUT", "TEXTAREA", "SELECT", "OPTION"]);

  /** Elements whose children are text only (plus <br>), outside the overlay itself. */
  function leaves(): HTMLElement[] {
    const out: HTMLElement[] = [];
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_ELEMENT);
    let n = walker.nextNode() as HTMLElement | null;
    while (n) {
      if (
        !SKIP.has(n.tagName) &&
        !n.closest("#dev-edit-bar") &&
        !n.closest("svg") &&
        n.childNodes.length > 0 &&
        [...n.childNodes].every((c) => c.nodeType === Node.TEXT_NODE || (c as HTMLElement).tagName === "BR") &&
        (n.textContent ?? "").trim().length >= 4
      ) {
        out.push(n);
      }
      n = walker.nextNode() as HTMLElement | null;
    }
    return out;
  }

  const norm = (s: string) => s.replace(/\s+/g, " ").trim();

  function enter() {
    on = true;
    original.clear();
    for (const el of leaves()) {
      original.set(el, norm(el.textContent ?? ""));
      el.contentEditable = "plaintext-only";
      el.classList.add("dev-edit-leaf");
      el.addEventListener("input", markDirty);
    }
    bar.hidden = false;
    setStatus("Edit mode · click any text · ⌘S saves · Esc cancels");
  }

  function leave(restore: boolean) {
    on = false;
    for (const [el, text] of original) {
      if (restore && norm(el.textContent ?? "") !== text) el.textContent = text;
      el.contentEditable = "false";
      el.classList.remove("dev-edit-leaf", "dev-edit-dirty", "dev-edit-error");
      el.removeEventListener("input", markDirty);
    }
    original.clear();
    bar.hidden = true;
  }

  function markDirty(e: Event) {
    const el = e.currentTarget as HTMLElement;
    el.classList.toggle("dev-edit-dirty", norm(el.textContent ?? "") !== original.get(el));
    el.classList.remove("dev-edit-error");
  }

  function setStatus(msg: string) {
    status.textContent = msg;
  }

  async function save() {
    const dirty = [...original].filter(([el, before]) => norm(el.textContent ?? "") !== before);
    if (!dirty.length) return setStatus("Nothing changed.");
    setStatus(`Saving ${dirty.length}…`);
    const results: string[] = [];
    let failed = 0;
    for (const [el, before] of dirty) {
      const after = norm(el.textContent ?? "");
      try {
        const r = await fetch("/__dev-edit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ before, after, url: location.pathname }),
        });
        const j = await r.json();
        if (r.ok) {
          original.set(el, after);
          el.classList.remove("dev-edit-dirty", "dev-edit-error");
          results.push(`✓ ${j.file ?? ""}`);
        } else {
          failed++;
          el.classList.add("dev-edit-error");
          results.push(`✗ ${j.error}${j.files ? " " + j.files.join(", ") : ""}`);
          console.warn("[dev-edit]", before, "→", j);
        }
      } catch (err) {
        failed++;
        el.classList.add("dev-edit-error");
        results.push(`✗ ${String(err)}`);
      }
    }
    setStatus(
      failed
        ? `${dirty.length - failed} saved, ${failed} failed (red outline; details in console).`
        : `Saved ${dirty.length} to ${[...new Set(results.map((r) => r.slice(2)))].join(", ")}`
    );
  }

  document.addEventListener("keydown", (e) => {
    const mod = e.metaKey || e.ctrlKey;
    if (mod && e.shiftKey && e.code === "KeyE") {
      e.preventDefault();
      on ? leave(true) : enter();
    } else if (on && mod && !e.shiftKey && e.code === "KeyS") {
      e.preventDefault();
      save();
    } else if (on && e.key === "Escape") {
      e.preventDefault();
      leave(true);
    }
  });
  document.getElementById("dev-edit-save")!.addEventListener("click", save);
  document.getElementById("dev-edit-cancel")!.addEventListener("click", () => leave(true));
</script>
