---
/**
 * Projected additional visits by age group, split into cold-driven and
 * heat-driven, for one decade at a time.
 *
 * A diverging axis is required rather than decorative: heat-driven visits for
 * children under 12 are NEGATIVE, which the paper attributes to fewer cases of
 * nasopharyngitis as temperatures rise. A chart that started at zero would hide
 * the one group that moves the other way.
 *
 * These per-group figures come from a different aggregation than the decade
 * totals in the companion chart and are deliberately NOT summed here.
 */
import ageData from "../../data/paper/m5_projections_by_age.json";
import { scaleLinear, scaleBand, niceTicks, type Lang } from "./chart-utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

interface AgeRow {
  effect: "Cold" | "Hot";
  decade: string;
  spec: string;
  difference: number;
}
const rows = ageData as AgeRow[];
const decades = [...new Set(rows.map((r) => r.decade))].sort();
const DEFAULT_DECADE = decades[decades.length - 1];
const EFFECTS = ["Cold", "Hot"] as const;

/* Source order runs youngest to oldest; keep it, since age is ordinal. */
const ORDER = ["< 12", "12 - 20", "20 - 40", "40 - 60", "60 - 80", "> 80"];
const specs = ORDER.filter((s) => rows.some((r) => r.spec === s));
const prettySpec = (s: string) => s.replace(/ - /g, "–").replace("< ", "<").replace("> ", "");

// --- geometry ---------------------------------------------------------------
const W = 780;
const LABEL_W = 66;
const M = { top: 40, right: 20, bottom: 40, left: LABEL_W + 14 };
const ROW_H = 46;
const plotW = W - M.left - M.right;
const H = M.top + specs.length * ROW_H + M.bottom;

const vals = rows.map((r) => r.difference / 1000);
const lo = Math.min(...vals, 0);
const hi = Math.max(...vals, 0);
const padX = (hi - lo) * 0.06;
const x = scaleLinear([lo - padX, hi + padX], [M.left, M.left + plotW]);
const ticks = niceTicks(lo - padX, hi + padX, 7);
const band = scaleBand(EFFECTS.length, [0, ROW_H - 12], 0.32);

const colour = { Cold: "var(--color-temp-cold)", Hot: "var(--color-temp-hot)" };

const strings = {
  en: {
    decade: "Decade:",
    xAxis: "Additional ED visits per decade (thousands)",
    ageLabel: "Age",
    cold: "cold-driven",
    hot: "heat-driven",
    caption:
      "Bars run from zero. Heat-driven visits fall for children under 12, which the paper attributes to fewer cases of the common cold as temperatures rise. These per-group figures use a different aggregation from the decade totals above and are not summed here.",
  },
  es: {
    decade: "Década:",
    xAxis: "Visitas adicionales a urgencias por década (miles)",
    ageLabel: "Edad",
    cold: "por frío",
    hot: "por calor",
    caption:
      "Las barras parten de cero. Las visitas por calor bajan en los menores de 12 años, lo que el artículo atribuye a menos casos de resfriado común al subir la temperatura. Estas cifras por grupo usan una agregación distinta de los totales por década de arriba y no se suman aquí.",
  },
}[lang];
---

<figure class="not-prose" data-chart="age-breakdown" data-decade={DEFAULT_DECADE}>
  <div class="mb-5 flex flex-wrap items-center gap-2">
    <span class="mr-1 text-[13px] text-slate-light">{strings.decade}</span>
    {
      decades.map((d) => (
        <button
          type="button"
          data-decade-btn={d}
          aria-pressed={d === DEFAULT_DECADE ? "true" : "false"}
          class="ab-btn tnum"
        >
          {d.replace(" - ", "–")}
        </button>
      ))
    }
  </div>

  <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-label={strings.xAxis}>
    {
      ticks.map((tv) => (
        <g>
          <line
            x1={x(tv)}
            x2={x(tv)}
            y1={M.top - 10}
            y2={M.top + specs.length * ROW_H - 10}
            stroke={tv === 0 ? "var(--color-rule-strong)" : "var(--color-rule)"}
            stroke-width={tv === 0 ? 1.25 : 1}
            stroke-dasharray={tv === 0 ? "none" : "2 4"}
          />
          <text
            x={x(tv)}
            y={M.top - 18}
            text-anchor="middle"
            class="tnum fill-slate-light text-[11.5px]"
          >
            {tv > 0 ? `+${tv}` : tv}
          </text>
        </g>
      ))
    }
    <text x={0} y={M.top - 18} class="fill-annotation text-[11.5px]">{strings.ageLabel}</text>
    <text
      x={M.left + plotW / 2}
      y={H - 8}
      text-anchor="middle"
      class="fill-annotation text-[12.5px]">{strings.xAxis}</text
    >

    {
      specs.map((spec, si) => {
        const top = M.top + si * ROW_H - 10;
        return (
          <g>
            <text
              x={LABEL_W}
              y={top + ROW_H / 2 - 2}
              text-anchor="end"
              class="tnum fill-charcoal text-[12.5px]"
            >
              {prettySpec(spec)}
            </text>
            {decades.map((d) => (
              <g
                class:list={["ab-decade", { "is-active": d === DEFAULT_DECADE }]}
                data-decade={d}
              >
                {EFFECTS.map((e, ei) => {
                  const row = rows.find(
                    (r) => r.spec === spec && r.decade === d && r.effect === e
                  );
                  if (!row) return null;
                  const v = row.difference / 1000;
                  const cy = top + band.centre(ei) + 4;
                  const x0 = x(0);
                  const x1 = x(v);
                  return (
                    <g>
                      <rect
                        x={Math.min(x0, x1)}
                        y={cy - band.width / 2}
                        width={Math.abs(x1 - x0)}
                        height={band.width}
                        fill={colour[e]}
                        opacity="0.92"
                      />
                      <text
                        x={x1 + (v < 0 ? -7 : 7)}
                        y={cy + 4}
                        text-anchor={v < 0 ? "end" : "start"}
                        class="tnum text-[11.5px] font-medium"
                        fill={colour[e]}
                      >
                        {v > 0 ? `+${v.toFixed(1)}` : `−${Math.abs(v).toFixed(1)}`}
                      </text>
                    </g>
                  );
                })}
              </g>
            ))}
          </g>
        );
      })
    }
  </svg>

  <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2 text-[13px] text-slate-light">
    <span class="inline-flex items-center gap-2">
      <svg width="14" height="10" aria-hidden="true"
        ><rect width="14" height="10" fill="var(--color-temp-cold)"></rect></svg
      >
      {strings.cold}
    </span>
    <span class="inline-flex items-center gap-2">
      <svg width="14" height="10" aria-hidden="true"
        ><rect width="14" height="10" fill="var(--color-temp-hot)"></rect></svg
      >
      {strings.hot}
    </span>
  </div>

  <figcaption class="mt-3 max-w-3xl text-[13.5px] leading-relaxed text-slate-light">
    {strings.caption}
  </figcaption>
</figure>

<style>
  .ab-btn {
    border: 1px solid var(--color-rule);
    border-radius: 3px;
    padding: 0.3rem 0.65rem;
    font-size: 12.5px;
    color: var(--color-slate-light);
    background: white;
    transition:
      background-color 140ms cubic-bezier(0.32, 0.72, 0, 1),
      border-color 140ms cubic-bezier(0.32, 0.72, 0, 1),
      color 140ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .ab-btn:hover {
    border-color: var(--color-rule-strong);
    color: var(--color-charcoal);
  }
  .ab-btn[aria-pressed="true"] {
    background: var(--color-slate);
    border-color: var(--color-slate);
    color: white;
  }
  .ab-btn:focus-visible {
    outline: 2px solid var(--color-sky);
    outline-offset: 2px;
  }
  .ab-decade {
    display: none;
  }
  .ab-decade.is-active {
    display: inline;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-chart="age-breakdown"]').forEach((fig) => {
    const buttons = fig.querySelectorAll<HTMLButtonElement>("[data-decade-btn]");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.dataset.decadeBtn!;
        fig.dataset.decade = key;
        fig
          .querySelectorAll<SVGElement>(".ab-decade")
          .forEach((g) => g.classList.toggle("is-active", g.dataset.decade === key));
        buttons.forEach((b) =>
          b.setAttribute("aria-pressed", String(b.dataset.decadeBtn === key))
        );
      });
    });
  });
</script>
