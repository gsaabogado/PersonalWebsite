---
/**
 * The 15 diagnostic chapters, ranked once and held still.
 *
 * The row order is fixed by the cumulative cold effect and never changes when
 * the reader switches interval or horizon: only the dots move. A chart whose
 * rows re-sort under you is much harder to read than one where you can track a
 * single condition across states, and this is the module where a practitioner is
 * looking for one particular service line.
 *
 * Baseline volume sits beside each label, because a large percentage on a rare
 * condition and a small percentage on a common one are very different operational
 * facts.
 */
import chapterData from "../../data/paper/m4_chapters.json";
import { scaleLinear, niceTicks, fmtPct, type Estimate, type Lang } from "./chart-utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

type Row = Estimate & {
  chapter: string;
  chapter_label_en: string;
  chapter_label_es: string;
  baseline_mean: number;
  nobs: number;
};
const rows = chapterData as Row[];

const BINS = [
  { bin: "-15_10", short: "≤10", side: "cold" },
  { bin: "10_15", short: "10–15", side: "cold" },
  { bin: "15_20", short: "15–20", side: "cold" },
  { bin: "25_30", short: "25–30", side: "hot" },
  { bin: "30_45", short: ">30", side: "hot" },
] as const;
const HORIZONS = [0, 30] as const;
const DEFAULT_BIN = "-15_10";
const DEFAULT_HORIZON = 30;

const chapters = [...new Set(rows.map((r) => r.chapter))]
  .map((c) => {
    const rs = rows.filter((r) => r.chapter === c);
    return {
      chapter: c,
      label: lang === "es" ? rs[0].chapter_label_es : rs[0].chapter_label_en,
      baseline: rs[0].baseline_mean,
      rows: rs,
    };
  })
  .sort((a, b) => {
    const av = a.rows.find((r) => r.bin === DEFAULT_BIN && r.horizon === DEFAULT_HORIZON)!;
    const bv = b.rows.find((r) => r.bin === DEFAULT_BIN && r.horizon === DEFAULT_HORIZON)!;
    return av.pct - bv.pct;
  });

// --- geometry ---------------------------------------------------------------
const LABEL_W = 176;
const VOL_W = 54;
const ROW_H = 25;
const M = { top: 54, right: 44, bottom: 16, left: LABEL_W + VOL_W + 16 };
const plotW = 780 - M.left - M.right;
const H = M.top + chapters.length * ROW_H + M.bottom;
const W = 780;

const xLo = Math.min(...rows.map((r) => r.ci_low), 0);
const xHi = Math.max(...rows.map((r) => r.ci_high), 0);
const padX = (xHi - xLo) * 0.03;
const x = scaleLinear([xLo - padX, xHi + padX], [M.left, M.left + plotW]);
const ticks = niceTicks(xLo - padX, xHi + padX, 7);
const maxBase = Math.max(...chapters.map((c) => c.baseline));

const strings = {
  en: {
    interval: "Temperature:",
    horizon: "Horizon:",
    sameDay: "Same day",
    cumulative: "Over 30 days",
    xAxis: "Change in ED visits for that chapter (%)",
    volume: "Visits per 100,000",
    caption:
      "Rows are ordered by the cumulative effect of a day below 10 °C and stay in that order as you change interval or horizon, so a single condition can be tracked across states. Bars beside each label show baseline volume on a shared scale. Whiskers are 95% confidence intervals.",
  },
  es: {
    interval: "Temperatura:",
    horizon: "Horizonte:",
    sameDay: "Mismo día",
    cumulative: "En 30 días",
    xAxis: "Cambio en visitas a urgencias de ese capítulo (%)",
    volume: "Visitas por 100,000",
    caption:
      "Las filas están ordenadas por el efecto acumulado de un día por debajo de 10 °C y conservan ese orden al cambiar el intervalo o el horizonte, de modo que se puede seguir un mismo padecimiento entre estados. Las barras junto a cada etiqueta muestran el volumen base en una escala compartida. Los bigotes son intervalos de confianza del 95%.",
  },
}[lang];

const stateKey = (bin: string, h: number) => `${bin}|${h}`;
const DEFAULT_STATE = stateKey(DEFAULT_BIN, DEFAULT_HORIZON);
---

<figure class="not-prose" data-chart="ranked-chapters" data-state={DEFAULT_STATE}>
  <div class="mb-5 flex flex-col gap-3">
    <div class="flex flex-wrap items-center gap-2">
      <span class="mr-1 text-[13px] text-slate-light">{strings.interval}</span>
      {
        BINS.map((b) => (
          <button
            type="button"
            data-bin-btn={b.bin}
            aria-pressed={b.bin === DEFAULT_BIN ? "true" : "false"}
            class="rc-btn tnum"
          >
            {b.short} °C
          </button>
        ))
      }
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <span class="mr-1 text-[13px] text-slate-light">{strings.horizon}</span>
      {
        HORIZONS.map((h) => (
          <button
            type="button"
            data-horizon-btn={h}
            aria-pressed={h === DEFAULT_HORIZON ? "true" : "false"}
            class="rc-btn"
          >
            {h === 0 ? strings.sameDay : strings.cumulative}
          </button>
        ))
      }
    </div>
  </div>

  <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-label={strings.xAxis}>
    {/* x gridlines */}
    {
      ticks.map((tv) => (
        <g>
          <line
            x1={x(tv)}
            x2={x(tv)}
            y1={M.top - 8}
            y2={M.top + chapters.length * ROW_H - 6}
            stroke={tv === 0 ? "var(--color-rule-strong)" : "var(--color-rule)"}
            stroke-width={tv === 0 ? 1.25 : 1}
            stroke-dasharray={tv === 0 ? "none" : "2 4"}
          />
          <text
            x={x(tv)}
            y={M.top - 12}
            text-anchor="middle"
            class="tnum fill-slate-light text-[11px]"
          >
            {tv > 0 ? `+${tv}` : tv}
          </text>
        </g>
      ))
    }
    <text x={M.left} y={14} class="fill-annotation text-[12px]">{strings.xAxis}</text>
    <text x={LABEL_W + 14} y={14} text-anchor="end" class="fill-annotation text-[11px]">
      {strings.volume}
    </text>

    {
      chapters.map((c, i) => {
        const cy = M.top + i * ROW_H + ROW_H / 2 - 4;
        const volW = (c.baseline / maxBase) * (VOL_W - 8);
        return (
          <g>
            {i % 2 === 1 && (
              <rect
                x={0}
                y={cy - ROW_H / 2}
                width={W}
                height={ROW_H}
                fill="var(--color-warm-gray)"
              />
            )}
            <text x={0} y={cy + 4} class="fill-charcoal text-[12.5px]">
              {c.label}
            </text>
            {/* baseline volume, shared scale */}
            <rect
              x={LABEL_W + 14 - volW}
              y={cy - 3.5}
              width={volW}
              height={7}
              fill="var(--color-cool-gray)"
            />
            <title>{`${c.label}: ${c.baseline} per 100,000`}</title>

            {BINS.map((b) =>
              HORIZONS.map((h) => {
                const d = c.rows.find((r) => r.bin === b.bin && r.horizon === h);
                if (!d) return null;
                const active = stateKey(b.bin, h) === DEFAULT_STATE;
                const colour = d.pct < 0 ? "var(--color-temp-cold)" : "var(--color-temp-hot)";
                const ci = d.pct < 0 ? "var(--color-temp-cold-ci)" : "var(--color-temp-hot-ci)";
                const outward = d.pct < 0 ? -1 : 1;
                return (
                  <g
                    class:list={["rc-state", { "is-active": active }]}
                    data-state={stateKey(b.bin, h)}
                  >
                    <line
                      x1={x(d.ci_low)}
                      x2={x(d.ci_high)}
                      y1={cy}
                      y2={cy}
                      stroke={ci}
                      stroke-width="6"
                      stroke-linecap="round"
                    />
                    <line
                      x1={x(0)}
                      x2={x(d.pct)}
                      y1={cy}
                      y2={cy}
                      stroke={colour}
                      stroke-width="1"
                      opacity="0.45"
                    />
                    <circle cx={x(d.pct)} cy={cy} r="4.4" fill={colour} />
                    <text
                      x={x(d.pct) + outward * 10}
                      y={cy + 4}
                      text-anchor={d.pct < 0 ? "end" : "start"}
                      class="tnum text-[11.5px] font-medium"
                      fill={colour}
                    >
                      {fmtPct(d.pct)}
                    </text>
                  </g>
                );
              })
            )}
          </g>
        );
      })
    }
  </svg>

  <figcaption class="mt-4 max-w-3xl text-[13.5px] leading-relaxed text-slate-light">
    {strings.caption}
  </figcaption>
</figure>

<style>
  .rc-btn {
    border: 1px solid var(--color-rule);
    border-radius: 3px;
    padding: 0.3rem 0.65rem;
    font-size: 12.5px;
    color: var(--color-slate-light);
    background: white;
    transition:
      background-color 140ms cubic-bezier(0.32, 0.72, 0, 1),
      border-color 140ms cubic-bezier(0.32, 0.72, 0, 1),
      color 140ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .rc-btn:hover {
    border-color: var(--color-rule-strong);
    color: var(--color-charcoal);
  }
  .rc-btn[aria-pressed="true"] {
    background: var(--color-slate);
    border-color: var(--color-slate);
    color: white;
  }
  .rc-btn:focus-visible {
    outline: 2px solid var(--color-sky);
    outline-offset: 2px;
  }

  .rc-state {
    display: none;
  }
  .rc-state.is-active {
    display: inline;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-chart="ranked-chapters"]').forEach((fig) => {
    const binBtns = fig.querySelectorAll<HTMLButtonElement>("[data-bin-btn]");
    const horBtns = fig.querySelectorAll<HTMLButtonElement>("[data-horizon-btn]");

    // Two independent selectors combine into one state key. Reading the current
    // pressed value from the DOM keeps the two groups from fighting each other.
    const current = () => {
      const bin = [...binBtns].find((b) => b.getAttribute("aria-pressed") === "true");
      const hor = [...horBtns].find((b) => b.getAttribute("aria-pressed") === "true");
      return `${bin?.dataset.binBtn}|${hor?.dataset.horizonBtn}`;
    };

    const apply = () => {
      const key = current();
      fig.dataset.state = key;
      fig
        .querySelectorAll<SVGElement>(".rc-state")
        .forEach((g) => g.classList.toggle("is-active", g.dataset.state === key));
    };

    const wire = (group: NodeListOf<HTMLButtonElement>, attr: string) =>
      group.forEach((btn) =>
        btn.addEventListener("click", () => {
          group.forEach((b) =>
            b.setAttribute("aria-pressed", String(b.dataset[attr] === btn.dataset[attr]))
          );
          apply();
        })
      );

    wire(binBtns, "binBtn");
    wire(horBtns, "horizonBtn");
  });
</script>
