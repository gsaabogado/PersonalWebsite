---
/**
 * Projected additional ED visits and public cost, by decade, split into the
 * cold-driven and heat-driven components.
 *
 * The vertical bars are the spread across five global climate models, not a
 * confidence interval: they describe disagreement between models, and the dot is
 * the model mean. Both are rendered for visits and for cost, since the two use
 * different units and therefore different scales.
 *
 * Units note: the source column is named `expenditures_annual` but holds the
 * DECADAL total, which is how the paper reports it (58.4 million USD for
 * 2031-2040). The paper's annual figure of roughly 8.5 million is the 2041-2060
 * decade average divided by ten.
 */
import rangeData from "../../data/paper/m5_projections_range.json";
import { scaleLinear, scaleBand, niceTicks, type Lang } from "./chart-utils";

interface Props {
  lang: Lang;
  /** Measure shown on load. */
  defaultMeasure?: "visits" | "cost";
  /** Hide the visits/cost toggle and show one measure only. */
  lockMeasure?: boolean;
}
const { lang, defaultMeasure, lockMeasure = false } = Astro.props;

interface RangeRow {
  decade: string;
  effect: "Cold" | "Hot";
  expenditures_annual_mean: number;
  difference_mean: number;
  expenditures_annual_min: number;
  difference_min: number;
  expenditures_annual_max: number;
  difference_max: number;
}
const rows = rangeData as RangeRow[];
const decades = [...new Set(rows.map((r) => r.decade))].sort();
const EFFECTS = ["Cold", "Hot"] as const;

const MEASURES = [
  {
    key: "visits",
    mean: "difference_mean",
    min: "difference_min",
    max: "difference_max",
    scale: 1 / 1000,
  },
  {
    key: "cost",
    mean: "expenditures_annual_mean",
    min: "expenditures_annual_min",
    max: "expenditures_annual_max",
    scale: 1 / 1e6,
  },
] as const;
const DEFAULT_MEASURE = defaultMeasure ?? "visits";

const get = (d: string, e: string, field: string) =>
  (rows.find((r) => r.decade === d && r.effect === e) as unknown as Record<string, number>)[
    field
  ];

// --- geometry ---------------------------------------------------------------
const W = 780;
const H = 400;
const M = { top: 44, right: 24, bottom: 60, left: 66 };
const plotW = W - M.left - M.right;
const plotH = H - M.top - M.bottom;
const band = scaleBand(decades.length, [M.left, M.left + plotW], 0.42);
const OFF = 26;

const colour = { Cold: "var(--color-temp-cold)", Hot: "var(--color-temp-hot)" };
const ciColour = { Cold: "var(--color-temp-cold-ci)", Hot: "var(--color-temp-hot-ci)" };

const strings = {
  en: {
    measure: "Show:",
    visits: "Additional visits",
    cost: "Public cost",
    visitsAxis: "Additional ED visits per decade (thousands)",
    costAxis: "Additional public cost per decade (million USD)",
    total: "decade total",
    cold: "fewer cold days",
    hot: "more hot days",
    costNote:
      "How the cost is estimated: each additional visit is valued at 207 USD, and the share of visits that end in hospitalisation, held at the historical rate, adds 691 USD each. Both unit costs are the Mexican Social Security Institute's official 2024 figures published in the Diario Oficial de la Federación (14 December 2023). Costs are summed over each decade and averaged across the five climate models. No adaptation, price change or capacity change is modelled.",
    range: "Cold days reduce visits, so as climate change makes them rarer, the low-visit days that cold used to cause disappear and visits rise. Heat adds visits directly, and climate change makes hot days more frequent, so visits from heat rise as well. Both components are therefore increases. Dots are the mean across five climate models; bars span the lowest and highest model.",
  },
  es: {
    measure: "Mostrar:",
    visits: "Visitas adicionales",
    cost: "Costo público",
    visitsAxis: "Visitas adicionales a urgencias por década (miles)",
    costAxis: "Costo público adicional por década (millones de USD)",
    total: "total de la década",
    cold: "menos días fríos",
    hot: "más días calurosos",
    costNote:
      "Cómo se estima el costo: cada visita adicional se valora en 207 USD, y la proporción de visitas que terminan en hospitalización, mantenida en la tasa histórica, añade 691 USD cada una. Ambos costos unitarios son las cifras oficiales de 2024 del Instituto Mexicano del Seguro Social publicadas en el Diario Oficial de la Federación (14 de diciembre de 2023). Los costos se suman por década y se promedian entre los cinco modelos climáticos. No se modela adaptación, cambio de precios ni cambio de capacidad.",
    range:
      "Los días fríos reducen las visitas, así que conforme el cambio climático los vuelve más raros, desaparecen los días de pocas visitas que el frío causaba y las visitas suben. El calor añade visitas directamente, y el cambio climático hace más frecuentes los días calurosos, así que las visitas por calor también suben. Ambos componentes son, por tanto, aumentos. Los puntos son la media de cinco modelos climáticos; las barras abarcan el modelo más bajo y el más alto.",
  },
}[lang];
---

<figure class="not-prose" data-chart="decade-range" data-measure={DEFAULT_MEASURE}>
  <div hidden={lockMeasure} class="mb-5 flex flex-wrap items-center gap-2">
    <span class="mr-1 text-[13px] text-slate-light">{strings.measure}</span>
    {
      MEASURES.map((m) => (
        <button
          type="button"
          data-measure-btn={m.key}
          aria-pressed={m.key === DEFAULT_MEASURE ? "true" : "false"}
          class="dr-btn"
        >
          {m.key === "visits" ? strings.visits : strings.cost}
        </button>
      ))
    }
  </div>

  <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-label={strings.visitsAxis}>
    {
      MEASURES.map((meas) => {
        const vals = rows.flatMap((r) => {
          const o = r as unknown as Record<string, number>;
          return [o[meas.min] * meas.scale, o[meas.max] * meas.scale];
        });
        const hi = Math.max(...vals, 0);
        const y = scaleLinear([0, hi * 1.1], [M.top + plotH, M.top]);
        const ticks = niceTicks(0, hi * 1.1, 5);

        return (
          <g class:list={["dr-measure", { "is-active": meas.key === DEFAULT_MEASURE }]}
            data-measure={meas.key}>
            {ticks.map((tv) => (
              <g>
                <line
                  x1={M.left}
                  x2={M.left + plotW}
                  y1={y(tv)}
                  y2={y(tv)}
                  stroke={tv === 0 ? "var(--color-rule-strong)" : "var(--color-rule)"}
                  stroke-width={tv === 0 ? 1.25 : 1}
                  stroke-dasharray={tv === 0 ? "none" : "2 4"}
                />
                <text
                  x={M.left - 10}
                  y={y(tv) + 4}
                  text-anchor="end"
                  class="tnum fill-slate-light text-[12px]"
                >
                  {tv}
                </text>
              </g>
            ))}
            <text x={M.left} y={18} class="fill-annotation text-[12.5px]">
              {meas.key === "visits" ? strings.visitsAxis : strings.costAxis}
            </text>

            {decades.map((d, di) => {
              const cx = band.centre(di);
              const totalMean =
                EFFECTS.reduce((s, e) => s + get(d, e, meas.mean), 0) * meas.scale;

              return (
                <g>
                  <text
                    x={cx}
                    y={M.top + plotH + 26}
                    text-anchor="middle"
                    class="tnum fill-charcoal text-[12.5px]"
                  >
                    {d.replace(" - ", "–")}
                  </text>
                  <text
                    x={cx}
                    y={M.top + plotH + 44}
                    text-anchor="middle"
                    class="tnum fill-slate-light text-[11.5px]"
                  >
                    {totalMean.toFixed(totalMean < 100 ? 1 : 0)} {strings.total}
                  </text>

                  {EFFECTS.map((e, ei) => {
                    const o = rows.find(
                      (r) => r.decade === d && r.effect === e
                    ) as unknown as Record<string, number>;
                    const px = cx + (ei === 0 ? -OFF : OFF);
                    const mean = o[meas.mean] * meas.scale;
                    const lo = o[meas.min] * meas.scale;
                    const hiv = o[meas.max] * meas.scale;
                    return (
                      <g>
                        <line
                          x1={px}
                          x2={px}
                          y1={y(lo)}
                          y2={y(hiv)}
                          stroke={ciColour[e]}
                          stroke-width="9"
                          stroke-linecap="round"
                        />
                        <circle cx={px} cy={y(mean)} r="5.5" fill={colour[e]} />
                        <text
                          x={px}
                          y={y(hiv) - 10}
                          text-anchor="middle"
                          class="tnum text-[11.5px] font-medium"
                          fill={colour[e]}
                        >
                          {mean.toFixed(mean < 100 ? 1 : 0)}
                        </text>
                      </g>
                    );
                  })}
                </g>
              );
            })}
          </g>
        );
      })
    }
  </svg>

  <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2 text-[13px] text-slate-light">
    <span class="inline-flex items-center gap-2">
      <svg width="14" height="14" aria-hidden="true"
        ><circle cx="7" cy="7" r="5" fill="var(--color-temp-cold)"></circle></svg
      >
      {strings.cold}
    </span>
    <span class="inline-flex items-center gap-2">
      <svg width="14" height="14" aria-hidden="true"
        ><circle cx="7" cy="7" r="5" fill="var(--color-temp-hot)"></circle></svg
      >
      {strings.hot}
    </span>
    <span>{strings.range}</span>
  </div>
  {
    DEFAULT_MEASURE === "cost" && (
      <p class="mt-3 text-[12.5px] leading-relaxed text-slate-light">{strings.costNote}</p>
    )
  }
</figure>

<style>
  .dr-btn {
    border: 1px solid var(--color-rule);
    border-radius: 3px;
    padding: 0.3rem 0.7rem;
    font-size: 13px;
    color: var(--color-slate-light);
    background: white;
    transition:
      background-color 140ms cubic-bezier(0.32, 0.72, 0, 1),
      border-color 140ms cubic-bezier(0.32, 0.72, 0, 1),
      color 140ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .dr-btn:hover {
    border-color: var(--color-rule-strong);
    color: var(--color-charcoal);
  }
  .dr-btn[aria-pressed="true"] {
    background: var(--color-slate);
    border-color: var(--color-slate);
    color: white;
  }
  .dr-btn:focus-visible {
    outline: 2px solid var(--color-sky);
    outline-offset: 2px;
  }
  .dr-measure {
    display: none;
  }
  .dr-measure.is-active {
    display: inline;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-chart="decade-range"]').forEach((fig) => {
    const buttons = fig.querySelectorAll<HTMLButtonElement>("[data-measure-btn]");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.dataset.measureBtn!;
        fig.dataset.measure = key;
        fig
          .querySelectorAll<SVGElement>(".dr-measure")
          .forEach((g) => g.classList.toggle("is-active", g.dataset.measure === key));
        buttons.forEach((b) =>
          b.setAttribute("aria-pressed", String(b.dataset.measureBtn === key))
        );
      });
    });
  });
</script>
