---
/**
 * Why cold is the surprise: the SHAPE of the temperature response for emergency
 * department visits against the shape for all-cause mortality.
 *
 * One panel, cumulative (30-day) effects only, two series on one percent
 * axis: visits slope down-to-up across the range, deaths form a U. Both are
 * 100 x a Poisson coefficient, so a shared axis is legitimate; but the
 * mortality estimates use a different specification (Cohen and
 * Dechezleprêtre's fixed effects, the paper's Figure A.5), so the prose
 * compares shapes, quotes numbers for visits only, and states the mortality
 * U-shape with a reference rather than quantifying it. Rebuilt 2026-08-21; the earlier version put cause-specific
 * deaths on a shared axis with all visits and quoted cumulative mortality
 * percentages, neither of which was a like-for-like comparison.
 */
import ModuleRail from "./ModuleRail.astro";
import GroupCurves from "./GroupCurves.astro";
import DataDownload from "./DataDownload.astro";
import edData from "../../data/paper/m1_curve.json";
import mortData from "../../data/paper/m2_mortality.json";
import { fmtMag, type Estimate, type Lang } from "./chart-utils";
import { MODULES, SECTION_BASE, modulePath } from "../../data/outreach";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const ed = edData as Estimate[];
const mort = mortData as Estimate[];

const at = (rows: Estimate[], bin: string, h: number) =>
  rows.find((r) => r.bin === bin && r.horizon === h)!;

/* One row schema for GroupCurves: visits first (dark), deaths second. */
const LABELS = {
  ed: { en: "Emergency department visits", es: "Visitas a urgencias", short_en: "Visits", short_es: "Visitas" },
  all_cause: { en: "Deaths, all causes", es: "Muertes, todas las causas", short_en: "Deaths", short_es: "Muertes" },
};
const tag = (rows: Estimate[], spec: "ed" | "all_cause", order: number) =>
  rows
    .filter((r) => !r.reference && (r.horizon === 0 || r.horizon === 30))
    .map((r) => ({
      ...r,
      spec,
      group_order: order,
      group_label_en: LABELS[spec].en,
      group_label_es: LABELS[spec].es,
      group_short_en: LABELS[spec].short_en,
      group_short_es: LABELS[spec].short_es,
    }));
const combined = [...tag(ed, "ed", 1), ...tag(mort, "all_cause", 2)];
const RAMP = ["#111c2b", "#8e9cb0"];

const n = {
  coldDay: fmtMag(at(ed, "-15_10", 0).pct),
  coldCum: fmtMag(at(ed, "-15_10", 30).pct),
  mildDay: fmtMag(at(ed, "15_20", 0).pct),
  warmDay: fmtMag(at(ed, "25_30", 0).pct),
  hotDay: fmtMag(at(ed, "30_45", 0).pct),
  hotCum: fmtMag(at(ed, "30_45", 30).pct),
};

const CD_DOI = "https://doi.org/10.1257/pol.20180594";
const self = MODULES.find((m) => m.id === "cold")!;
const next = MODULES.find((m) => m.id === "who")!;

const strings = {
  en: {
    eyebrow: self.short.en,
    h1: self.question.en,
    standfirst: `Mortality rises at both ends of the temperature distribution; that U shape is well documented, for Mexico by Cohen and Dechezleprêtre (2022). Emergency department visits do not follow it. They rise with temperature across the whole range: an additional day below 10 °C reduces them by ${n.coldDay}, a day above 30 °C raises them by ${n.hotDay}.`,
    yAxis: "Change accounting for the following 30 days (%)",
    figTitle: "Two outcomes, one axis",
    figNote:
      "Cumulative effects over 30 days for mortality and ED visits. Visits slope in one direction across the whole range; deaths rise at both ends.",
    readTitle: "What to read here",
    read: [
      `Visits are monotonic. Each interval colder than the reference reduces them more than the last (${n.mildDay} at 15 to 20 °C, ${n.coldDay} below 10 °C) and each warmer interval raises them (${n.warmDay} at 25 to 30 °C, ${n.hotDay} above 30 °C). There is no turning point.`,
      `Deaths behave differently. Once the following 30 days are accounted for, the mortality curve is higher at both ends than in the middle: cold days and hot days both raise deaths relative to a day at 20 to 25 °C.`,
      `The disagreement is at the cold end. At the hot end both outcomes move up. At the cold end deaths move up while visits move down, and the reduction in visits grows rather than reverses: ${n.coldDay} on the day, ${n.coldCum} once the following 30 days are accounted for.`,
    ],
    whyTitle: "Why this matters",
    why: `Emergency department volume measures demand for emergency care, not population health. At the cold end of the distribution fewer people come to the emergency room, on the day and in the weeks after. The paper's mechanism section discusses why visits fall: fewer infections spread by vectors and food, fewer injuries, and patients staying home.`,
    linearTitle: "The shape, not just the level",
    linear: `The paper's summary statement is that, unlike mortality, the demand for emergency care responds to temperature roughly linearly. That is what the visits series shows, and it is what the rest of this site unpacks: by age (the young respond most), by diagnosis (respiratory is the one chapter that rises after cold), and in the projections (a warming Mexico trades fewer cold days for more hot ones, with visits of different severity).`,
    notesTitle: "What is being estimated",
    notes: [
      "Visits: the paper's main specification, a Poisson distributed lag model with 30 lags on the ED visit rate per 100,000 people by municipality and day, 2008 to 2021, with municipality-by-year-month and municipality-by-weekday fixed effects, weather controls, population weights, and standard errors clustered by municipality.",
      "Deaths: all-cause deaths per 100,000 people by municipality and day over the same years, in the same Poisson distributed lag form, but with the model of Cohen and Dechezleprêtre (2022): municipality by day of year, municipality by year, and date.",
    ],
    cite: "Cohen, F. and A. Dechezleprêtre (2022). Mortality, Temperature, and Public Health Provision: Evidence from Mexico. American Economic Journal: Economic Policy 14(2), 161–192.",
    nextLabel: "Next",
    backLabel: "All questions",
  },
  es: {
    eyebrow: self.short.es,
    h1: self.question.es,
    standfirst: `La mortalidad sube en los dos extremos de la distribución de temperatura; esa forma de U está bien documentada, para México por Cohen y Dechezleprêtre (2022). Las visitas a urgencias no la siguen. Suben con la temperatura en todo el rango: un día adicional por debajo de 10 °C las reduce ${n.coldDay}, y un día por encima de 30 °C las aumenta ${n.hotDay}.`,
    yAxis: "Cambio contando los 30 días siguientes (%)",
    figTitle: "Dos resultados, un solo eje",
    figNote:
      "Efectos acumulados a 30 días para la mortalidad y las visitas a urgencias. Las visitas se inclinan en una sola dirección en todo el rango; las muertes suben en los dos extremos.",
    readTitle: "Qué leer aquí",
    read: [
      `Las visitas son monótonas. Cada intervalo más frío que la referencia las reduce más que el anterior (${n.mildDay} entre 15 y 20 °C, ${n.coldDay} por debajo de 10 °C) y cada intervalo más cálido las aumenta (${n.warmDay} entre 25 y 30 °C, ${n.hotDay} por encima de 30 °C). No hay punto de inflexión.`,
      `Las muertes se comportan distinto. Una vez contados los 30 días siguientes, la curva de mortalidad es más alta en los dos extremos que en el centro: tanto los días fríos como los calurosos aumentan las muertes respecto a un día de 20 a 25 °C.`,
      `El desacuerdo está en el extremo frío. En el extremo caluroso ambos resultados suben. En el frío las muertes suben mientras las visitas bajan, y la reducción de visitas crece en vez de revertirse: ${n.coldDay} el mismo día, ${n.coldCum} una vez contados los 30 días siguientes.`,
    ],
    whyTitle: "Por qué importa",
    why: `El volumen de urgencias mide la demanda de atención de urgencias, no la salud de la población. En el extremo frío de la distribución menos personas acuden a urgencias, el mismo día y en las semanas posteriores. La sección de mecanismos del artículo discute por qué caen las visitas: menos infecciones transmitidas por vectores y alimentos, menos lesiones, y pacientes que se quedan en casa.`,
    linearTitle: "La forma, no solo el nivel",
    linear: `La afirmación de síntesis del artículo es que, a diferencia de la mortalidad, la demanda de atención de urgencias responde a la temperatura de forma aproximadamente lineal. Eso es lo que muestra la serie de visitas, y es lo que el resto de este sitio desglosa: por edad (los jóvenes responden más), por diagnóstico (el respiratorio es el único capítulo que sube tras el frío) y en las proyecciones (un México más cálido cambia días fríos por días calurosos, con visitas de distinta gravedad).`,
    notesTitle: "Qué se está estimando",
    notes: [
      "Visitas: la especificación principal del artículo, un modelo Poisson de rezagos distribuidos con 30 rezagos sobre la tasa de visitas a urgencias por cada 100,000 personas por municipio y día, 2008 a 2021, con efectos fijos de municipio por año-mes y municipio por día de la semana, controles de clima, pesos de población y errores estándar agrupados por municipio.",
      "Muertes: muertes por todas las causas por cada 100,000 personas por municipio y día en los mismos años, en la misma forma Poisson de rezagos distribuidos, pero con el modelo de Cohen y Dechezleprêtre (2022): municipio por día del año, municipio por año, y fecha.",
    ],
    cite: "Cohen, F. y A. Dechezleprêtre (2022). Mortality, Temperature, and Public Health Provision: Evidence from Mexico. American Economic Journal: Economic Policy 14(2), 161–192.",
    nextLabel: "Siguiente",
    backLabel: "Todas las preguntas",
  },
}[lang];
---

<ModuleRail lang={lang} current="cold" />

<div class="mx-auto max-w-6xl px-6">
  <header class="max-w-3xl border-b border-rule py-12 sm:py-16">
    <p class="text-[13px] text-slate-light">{strings.eyebrow}</p>
    <h1
      class="mt-3 font-display text-[1.9rem] leading-[1.18] font-semibold text-charcoal sm:text-[2.5rem]"
    >
      {strings.h1}
    </h1>
    <p class="mt-5 text-[1.0625rem] leading-relaxed text-slate-light">
      {strings.standfirst}
    </p>
  </header>

  <section class="py-12 sm:py-16">
    <h2 class="font-display text-[1.3rem] leading-snug font-semibold text-charcoal">
      {strings.figTitle}
    </h2>
    <p class="mt-2 max-w-3xl text-[14px] leading-relaxed text-slate-light">{strings.figNote}</p>

    <div class="mt-6">
      <GroupCurves
        lang={lang}
        rows={combined}
        ramp={RAMP}
        chartId="cold"
        defaultOn={["ed", "all_cause"]}
        defaultHorizon={30}
        yAxisLabel={strings.yAxis}
        height={500}
      />
    </div>
    <DataDownload lang={lang} files={["m1_curve", "m2_mortality"]} />

    <h3 class="mt-12 text-[13px] font-medium text-slate-light">{strings.readTitle}</h3>
    <ol class="mt-4 grid list-none gap-8 lg:grid-cols-3">
      {
        strings.read.map((para) => (
          <li class="border-l-2 border-rule pl-4 text-[14.5px] leading-relaxed text-slate">
            {para}
          </li>
        ))
      }
    </ol>
  </section>

  {/* The operational consequence, given its own weight. */}
  <section class="border-t border-rule py-10 sm:py-12">
    <div class="max-w-3xl border-l-4 border-temp-cold bg-warm-gray px-5 py-4">
      <h2 class="font-display text-[1.15rem] font-semibold text-charcoal">
        {strings.whyTitle}
      </h2>
      <p class="mt-2 text-[14.5px] leading-relaxed text-slate">{strings.why}</p>
    </div>
  </section>

  <section class="border-t border-rule py-10 sm:py-12">
    <h2 class="font-display text-[1.15rem] font-semibold text-charcoal">
      {strings.linearTitle}
    </h2>
    <p class="mt-3 max-w-3xl text-[14.5px] leading-relaxed text-slate-light">
      {strings.linear}
    </p>
  </section>

  <section class="border-t border-rule py-12 sm:py-16">
    <h2 class="text-[13px] font-medium text-slate-light">{strings.notesTitle}</h2>
    <div class="mt-4 grid max-w-5xl gap-6 sm:grid-cols-2">
      {
        strings.notes.map((para) => (
          <p class="text-[13.5px] leading-relaxed text-slate-light">{para}</p>
        ))
      }
    </div>
    <p class="mt-6 max-w-3xl text-[13px] leading-relaxed text-slate-light">
      <a href={CD_DOI} class="text-sky underline underline-offset-4">{strings.cite}</a>
    </p>
  </section>

  <nav class="flex flex-wrap items-baseline justify-between gap-4 border-t border-rule py-8">
    <a href={SECTION_BASE[lang]} class="text-[14px] text-sky underline underline-offset-4">
      ← {strings.backLabel}
    </a>
    <a
      href={modulePath(next, lang)}
      class="text-[14px] text-sky underline underline-offset-4"
    >
      {strings.nextLabel}: {next.question[lang]} →
    </a>
  </nav>
</div>
