---
import ModuleRail from "./ModuleRail.astro";
import {
  MODULES,
  modulePath,
  PAPER,
  type Lang,
  type OutreachModule,
} from "../../data/outreach";
import curveData from "../../data/paper/m1_curve.json";
import chapterData from "../../data/paper/m4_chapters.json";
import ageData from "../../data/paper/m3_age.json";
import mortData from "../../data/paper/m2_mortality.json";
import sevData from "../../data/paper/m5_projections_severity.json";
import { fmtMag, fmtPct } from "./chart-utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

/* Every figure in the practitioner panel is read from the exported estimates, so
   the takeaways cannot drift from the modules they point at. */
type Row = Record<string, unknown> & { bin: string; horizon: number; pct: number };
const pick = (rows: unknown[], pred: (r: Row) => boolean) =>
  (rows as Row[]).find(pred)!;

const coldCum = pick(curveData, (r) => r.bin === "-15_10" && r.horizon === 30);
const coldDay = pick(curveData, (r) => r.bin === "-15_10" && r.horizon === 0);
const resp = pick(
  chapterData,
  (r) => r.chapter === "respiratory" && r.bin === "-15_10" && r.horizon === 30
);
const infect = pick(
  chapterData,
  (r) => r.chapter === "infectious_parasatic" && r.bin === "-15_10" && r.horizon === 30
);
const risingChapters = (chapterData as Row[]).filter(
  (r) => r.bin === "-15_10" && r.horizon === 30 && r.pct > 0
).length;
const teens = pick(ageData, (r) => r.spec === "12_20" && r.bin === "-15_10" && r.horizon === 30);
const oldest = pick(ageData, (r) => r.spec === "80_130" && r.bin === "-15_10" && r.horizon === 30);
const circCum = pick(mortData, (r) => r.spec === "circ" && r.bin === "-15_10" && r.horizon === 30);
const sevLast = (sevData as Array<Record<string, unknown>>).filter(
  (r) => r.outcome === "Hospitalized" && r.decade === "2051 - 2060"
);
const hotShare = Math.round(
  (sevLast.find((r) => r.effect === "Hot")!.share_hospitalized as number) * 100
);
const coldShare = Math.round(
  (sevLast.find((r) => r.effect === "Cold")!.share_hospitalized as number) * 100
);

const mod = (id: string) => MODULES.find((m) => m.id === id)!;

const strings = {
  en: {
    eyebrow: `${PAPER.journal} · forthcoming`,
    h1: "Cold weather reduces emergency department visits in Mexico by more than heat increases them.",
    standfirst:
      "Daily records from the universe of public hospitals in Mexico, 2008 to 2021. Cold days reduce emergency department visits by up to 9.1 percent on the day itself, and by up to 16 percent once the following month is counted. Hot days raise them by up to 3.7 percent. Unlike deaths, the demand for emergency care responds to temperature almost linearly.",
    startHere: "Start here",
    alsoIn: "The rest of the evidence",
    soon: "In progress",
    useTitle: "What to do with this",
    useIntro:
      "Five things that follow from the estimates and that change how emergency services are planned rather than how they are described.",
    uses: [
      ["cold", `A cold snap is a blind spot, not a quiet spell.`, `Visits fall ${fmtMag(coldCum.pct)} over the following month while circulatory deaths rise ${fmtMag(circCum.pct)}. Any surveillance that watches arrivals alone will read the period of greatest harm as calm.`],
      ["curve", `Plan a month, not a day.`, `The cold effect grows from ${fmtMag(coldDay.pct)} on the day to ${fmtMag(coldCum.pct)} once thirty days are counted. A same-day count sees a third of it.`],
      ["conditions", `Staff service lines separately.`, `The aggregate fall hides ${risingChapters} diagnostic chapters that rise. Respiratory visits go up ${fmtPct(resp.pct)} over thirty days while infectious and parasitic fall ${fmtMag(infect.pct)}.`],
      ["who", `Paediatric capacity is the most weather-sensitive.`, `Over thirty days the 12 to 20 group moves ${fmtMag(teens.pct)} against ${fmtMag(oldest.pct)} for the over-80s, the opposite of the mortality age gradient.`],
      ["projections", `Equal visit counts do not mean equal bed demand.`, `Around ${hotShare} percent of the extra heat-driven visits projected for midcentury need admission, against ${coldShare} percent of the cold-driven ones, on a historical rate of 13 percent.`],
    ],
    aboutTitle: "What this is",
    about:
      "A companion to the paper, built for people who plan and staff emergency services rather than for referees. Every figure is an estimate from the published paper, shown with its confidence interval and downloadable as the numbers behind it. Nothing here is new analysis.",
    citeTitle: "Cite the paper",
    dataTitle: "Data and code",
    dataBody:
      "The full replication package, including the code that produced every estimate on this site, and the archived data.",
  },
  es: {
    eyebrow: `${PAPER.journal} · en prensa`,
    h1: "El frío reduce las visitas a urgencias en México más de lo que el calor las aumenta.",
    standfirst:
      "Registros diarios de la totalidad de los hospitales públicos de México, de 2008 a 2021. Los días fríos reducen las visitas a urgencias hasta 9.1 por ciento el mismo día, y hasta 16 por ciento contando el mes siguiente. Los días calurosos las aumentan hasta 3.7 por ciento. A diferencia de las muertes, la demanda de atención de urgencias responde a la temperatura de forma casi lineal.",
    startHere: "Empieza aquí",
    alsoIn: "El resto de la evidencia",
    soon: "En preparación",
    useTitle: "Qué hacer con esto",
    useIntro:
      "Cinco cosas que se siguen de las estimaciones y que cambian cómo se planean los servicios de urgencias, no cómo se describen.",
    uses: [
      ["cold", `Una racha de frío es un punto ciego, no un periodo tranquilo.`, `Las visitas caen ${fmtMag(coldCum.pct)} en el mes siguiente mientras las muertes circulatorias suben ${fmtMag(circCum.pct)}. Cualquier vigilancia que observe solo las llegadas leerá el periodo de mayor daño como calmado.`],
      ["curve", `Planea un mes, no un día.`, `El efecto del frío crece de ${fmtMag(coldDay.pct)} el mismo día a ${fmtMag(coldCum.pct)} al contar treinta días. Un conteo del mismo día ve un tercio.`],
      ["conditions", `Dota de personal cada línea de servicio por separado.`, `La caída agregada esconde ${risingChapters} capítulos diagnósticos que suben. Las visitas respiratorias aumentan ${fmtPct(resp.pct)} en treinta días mientras las infecciosas y parasitarias caen ${fmtMag(infect.pct)}.`],
      ["who", `La capacidad pediátrica es la más sensible al clima.`, `En treinta días el grupo de 12 a 20 años se mueve ${fmtMag(teens.pct)} frente a ${fmtMag(oldest.pct)} en los mayores de 80, lo opuesto al gradiente de edad de la mortalidad.`],
      ["projections", `Conteos de visitas iguales no implican demanda de camas igual.`, `Cerca de ${hotShare} por ciento de las visitas adicionales por calor proyectadas a mediados de siglo requieren ingreso, frente a ${coldShare} por ciento de las de frío, sobre una tasa histórica de 13 por ciento.`],
    ],
    aboutTitle: "Qué es esto",
    about:
      "Un complemento del artículo, hecho para quienes planean y dotan de personal los servicios de urgencias, no para dictaminadores. Cada figura es una estimación del artículo publicado, con su intervalo de confianza y descargable con los números que la producen. Nada aquí es análisis nuevo.",
    citeTitle: "Cita el artículo",
    dataTitle: "Datos y código",
    dataBody:
      "El paquete de replicación completo, incluyendo el código que produjo cada estimación de este sitio, y los datos archivados.",
  },
}[lang];

const live: OutreachModule[] = MODULES.filter((m) => m.status === "live");
const soon: OutreachModule[] = MODULES.filter((m) => m.status === "soon");
---

<ModuleRail lang={lang} current="hub" />

<div class="mx-auto max-w-6xl px-6">
  {/* --- header. No badge above the H1, no centred hero. ------------------- */}
  <header class="max-w-3xl border-b border-rule py-14 sm:py-20">
    <p class="text-[13px] tracking-normal text-slate-light">{strings.eyebrow}</p>
    <h1
      class="mt-4 font-display text-[2.1rem] leading-[1.15] font-semibold text-charcoal sm:text-[2.9rem]"
    >
      {strings.h1}
    </h1>
    <p class="mt-6 text-[1.0625rem] leading-relaxed text-slate-light sm:text-[1.125rem]">
      {strings.standfirst}
    </p>
    <p class="mt-6 text-[14px] text-slate-light">
      {PAPER.authors}
    </p>
  </header>

  {/* --- the way in ------------------------------------------------------- */}
  <section class="py-12 sm:py-16">
    <h2 class="text-[13px] font-medium tracking-normal text-slate-light">
      {strings.startHere}
    </h2>

    {
      live.map((m) => (
        <a href={modulePath(m, lang)} class="hub-lead group mt-5 block max-w-3xl">
          <span
            class="block font-display text-[1.65rem] leading-snug font-semibold text-charcoal sm:text-[2rem]"
          >
            {m.question[lang]}
          </span>
          <span class="mt-3 block text-[15px] leading-relaxed text-slate-light">
            {m.blurb[lang]}
          </span>
        </a>
      ))
    }

    <h2 class="mt-16 text-[13px] font-medium tracking-normal text-slate-light">
      {strings.alsoIn}
    </h2>
    <ul class="mt-5 grid list-none gap-x-12 gap-y-8 sm:grid-cols-2">
      {
        soon.map((m) => (
          <li>
            <span class="block font-display text-[1.15rem] leading-snug text-slate-light">
              {m.question[lang]}
            </span>
            <span class="mt-1.5 block text-[14px] leading-relaxed text-rule-strong">
              {m.blurb[lang]}
            </span>
            <span class="mt-2 inline-block text-[12px] text-rule-strong">
              {strings.soon}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  {/* --- what to do with this -------------------------------------------- */}
  <section class="border-t border-rule py-12 sm:py-16">
    <h2 class="font-display text-[1.5rem] leading-snug font-semibold text-charcoal">
      {strings.useTitle}
    </h2>
    <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-slate-light">
      {strings.useIntro}
    </p>
    <ol class="mt-8 grid list-none gap-x-10 gap-y-8 lg:grid-cols-2">
      {
        strings.uses.map(([id, claim, why]) => (
          <li class="border-l-2 border-temp-cold pl-4">
            <p class="font-display text-[1.1rem] leading-snug font-semibold text-charcoal">
              {claim}
            </p>
            <p class="mt-1.5 text-[14.5px] leading-relaxed text-slate-light">{why}</p>
            <a
              href={modulePath(mod(id), lang)}
              class="mt-2 inline-block text-[13px] text-sky underline underline-offset-4"
            >
              {mod(id).short[lang]} →
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  {/* --- about, citation, access ------------------------------------------ */}
  <section class="grid gap-10 border-t border-rule py-12 sm:grid-cols-3 sm:py-16">
    <div>
      <h2 class="font-display text-[1.15rem] font-semibold text-charcoal">
        {strings.aboutTitle}
      </h2>
      <p class="mt-3 text-[14.5px] leading-relaxed text-slate-light">{strings.about}</p>
    </div>
    <div>
      <h2 class="font-display text-[1.15rem] font-semibold text-charcoal">
        {strings.citeTitle}
      </h2>
      <p class="mt-3 text-[14.5px] leading-relaxed text-slate-light">
        {PAPER.authors}. <span class="italic">{PAPER.title[lang]}</span>.{" "}
        {PAPER.journal}.
      </p>
    </div>
    <div>
      <h2 class="font-display text-[1.15rem] font-semibold text-charcoal">
        {strings.dataTitle}
      </h2>
      <p class="mt-3 text-[14.5px] leading-relaxed text-slate-light">
        {strings.dataBody}
      </p>
      <p class="mt-3 flex flex-col gap-1 text-[14px]">
        <a href={PAPER.codeUrl} class="hub-link">{PAPER.codeUrl.replace("https://", "")}</a>
        <a href={PAPER.dataUrl} class="hub-link tnum">doi:{PAPER.dataDoi}</a>
      </p>
    </div>
  </section>
</div>

<style>
  /* The lead link is the one place with deliberate emphasis. Underline grows on
     hover; nothing fades in on arrival. */
  .hub-lead > span:first-child {
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    transition:
      text-decoration-color 160ms cubic-bezier(0.32, 0.72, 0, 1),
      text-underline-offset 160ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .hub-lead:hover > span:first-child {
    text-decoration-color: var(--color-temp-cold);
    text-underline-offset: 4px;
  }
  .hub-lead:focus-visible {
    outline: 2px solid var(--color-sky);
    outline-offset: 4px;
  }

  .hub-link {
    color: var(--color-sky);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    word-break: break-word;
  }
  .hub-link:hover {
    color: var(--color-slate);
  }
</style>
