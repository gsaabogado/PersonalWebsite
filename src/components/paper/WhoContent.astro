---
import ModuleRail from "./ModuleRail.astro";
import GroupCurves from "./GroupCurves.astro";
import DataDownload from "./DataDownload.astro";
import ageData from "../../data/paper/m3_age.json";
import sexData from "../../data/paper/m3_sex.json";
import { fmtMag, type Estimate, type Lang } from "./chart-utils";
import { MODULES, SECTION_BASE, modulePath } from "../../data/outreach";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

type Row = Estimate & {
  spec: string;
  group_order: number;
  group_label_en: string;
  group_label_es: string;
};
const age = ageData as Row[];
const sex = sexData as Row[];

/* Numbers read from the data so the prose cannot drift from the panels. */
const coldCum = (rows: Row[], spec: string) =>
  rows.find((r) => r.spec === spec && r.bin === "-15_10" && r.horizon === 30)!;
const coldDay = (rows: Row[], spec: string) =>
  rows.find((r) => r.spec === spec && r.bin === "-15_10" && r.horizon === 0)!;

const ageSpecs = [...new Set(age.map((r) => r.spec))];
const cumRanked = ageSpecs
  .map((s) => ({ spec: s, row: coldCum(age, s) }))
  .sort((a, b) => a.row.pct - b.row.pct);
const dayRanked = ageSpecs
  .map((s) => ({ spec: s, row: coldDay(age, s) }))
  .sort((a, b) => a.row.pct - b.row.pct);

const label = (r: Row) => (lang === "es" ? r.group_label_es : r.group_label_en);

const biggestCum = cumRanked[0];
const smallestCum = cumRanked[cumRanked.length - 1];
const biggestDay = dayRanked[0];
const women = coldCum(sex, "female");
const men = coldCum(sex, "male");

const n = {
  biggestCumLabel: label(biggestCum.row),
  biggestCum: fmtMag(biggestCum.row.pct),
  smallestCumLabel: label(smallestCum.row),
  smallestCum: fmtMag(smallestCum.row.pct),
  biggestDayLabel: label(biggestDay.row),
  biggestDay: fmtMag(biggestDay.row.pct),
  women: fmtMag(women.pct),
  men: fmtMag(men.pct),
};

/* Sequential neutral ramp, light = youngest. Kept off the temperature palette. */
const AGE_RAMP = ["#a8b6c8", "#8496ad", "#647892", "#485c76", "#31435a", "#1e293b"];
const SEX_RAMP = ["#7f93ab", "#28374b"];

const self = MODULES.find((m) => m.id === "who")!;
const next = MODULES.find((m) => m.id === "conditions")!;

const strings = {
  en: {
    eyebrow: self.short.en,
    h1: self.question.en,
    standfirst: `Every age group reduces its emergency department use on cold days, but not by the same amount and not on the same timetable. Over 30 days the response ranges from ${n.biggestCum} among people aged ${n.biggestCumLabel} down to ${n.smallestCum} among those aged ${n.smallestCumLabel}.`,
    fig1: "By age group",
    fig2: "By sex",
    read1Title: "What to read here",
    read1: [
      `The youngest respond fastest. Children aged ${n.biggestDayLabel} show the largest same-day reduction, ${n.biggestDay}, which is what you would expect if the mechanism runs partly through a caregiver deciding whether to travel.`,
      `Teenagers respond most in total. Over 30 days the ${n.biggestCumLabel} group reaches ${n.biggestCum}, the largest cumulative effect of any age group.`,
      `The oldest group barely accumulates. Among people aged ${n.smallestCumLabel} the cumulative cold effect is ${n.smallestCum}, far smaller than for any younger group. Note what this is and is not: it describes the demand for emergency care, not deaths, and the mortality literature finds the opposite age gradient.`,
    ],
    read2Title: "Women and men",
    read2: `The difference by sex is small next to the differences by age. Over 30 days the cold response is ${n.women} for women and ${n.men} for men, on a scale where the age groups span ${n.smallestCum} to ${n.biggestCum}.`,
    notesTitle: "What is being estimated",
    notes: [
      "Each group is a separate Poisson distributed lag model fitted to that group alone, with 30 lags, and effects are measured against a day between 20 and 25 °C.",
      "Every group is drawn on one set of axes, so the curves are directly comparable. The vertical scale differs between the same-day and 30-day views because the 30-day confidence intervals are roughly twice as wide.",
      "Percentages are 100 times the estimated coefficient. Bands are 95% confidence intervals, clustered at the municipality level.",
    ],
    nextLabel: "Next",
    backLabel: "All questions",
    soon: "in progress",
  },
  es: {
    eyebrow: self.short.es,
    h1: self.question.es,
    standfirst: `Todos los grupos de edad reducen su uso de urgencias en los días fríos, pero no en la misma medida ni en el mismo plazo. En 30 días la respuesta va de ${n.biggestCum} entre las personas de ${n.biggestCumLabel} años hasta ${n.smallestCum} entre las de ${n.smallestCumLabel}.`,
    fig1: "Por grupo de edad",
    fig2: "Por sexo",
    read1Title: "Qué leer aquí",
    read1: [
      `Los más jóvenes responden más rápido. Los niños de ${n.biggestDayLabel} años muestran la mayor reducción el mismo día, ${n.biggestDay}, que es lo que cabría esperar si parte del mecanismo pasa por la decisión de un cuidador de trasladarse o no.`,
      `Los adolescentes responden más en total. En 30 días el grupo de ${n.biggestCumLabel} años llega a ${n.biggestCum}, el mayor efecto acumulado de cualquier grupo de edad.`,
      `El grupo de mayor edad casi no acumula. Entre las personas de ${n.smallestCumLabel} años el efecto acumulado del frío es ${n.smallestCum}, mucho menor que en cualquier grupo más joven. Conviene precisar qué es y qué no es esto: describe la demanda de atención de urgencias, no las muertes, y la literatura de mortalidad encuentra el gradiente de edad opuesto.`,
    ],
    read2Title: "Mujeres y hombres",
    read2: `La diferencia por sexo es pequeña al lado de las diferencias por edad. En 30 días la respuesta al frío es de ${n.women} en mujeres y ${n.men} en hombres, en una escala donde los grupos de edad van de ${n.smallestCum} a ${n.biggestCum}.`,
    notesTitle: "Qué se está estimando",
    notes: [
      "Cada grupo es un modelo Poisson de rezagos distribuidos ajustado solo a ese grupo, con 30 rezagos, y los efectos se miden contra un día de entre 20 y 25 °C.",
      "Todos los grupos se dibujan sobre un mismo par de ejes, así que las curvas son directamente comparables. La escala vertical difiere entre la vista del mismo día y la de 30 días porque los intervalos de confianza a 30 días son cerca del doble de anchos.",
      "Los porcentajes son 100 veces el coeficiente estimado. Las bandas son intervalos de confianza del 95%, agrupados a nivel municipio.",
    ],
    nextLabel: "Siguiente",
    backLabel: "Todas las preguntas",
    soon: "en preparación",
  },
}[lang];
---

<ModuleRail lang={lang} current="who" />

<div class="mx-auto max-w-6xl px-6">
  <header class="max-w-3xl border-b border-rule py-12 sm:py-16">
    <p class="text-[13px] text-slate-light">{strings.eyebrow}</p>
    <h1
      class="mt-3 font-display text-[1.9rem] leading-[1.18] font-semibold text-charcoal sm:text-[2.5rem]"
    >
      {strings.h1}
    </h1>
    <p class="mt-5 text-[1.0625rem] leading-relaxed text-slate-light">
      {strings.standfirst}
    </p>
  </header>

  <section class="py-12 sm:py-16">
    <h2 class="font-display text-[1.3rem] leading-snug font-semibold text-charcoal">
      {strings.fig1}
    </h2>
    <div class="mt-6">
      <GroupCurves lang={lang} rows={age} ramp={AGE_RAMP} chartId="age" />
    </div>
    <DataDownload lang={lang} files={["m3_age"]} />

    <h3 class="mt-12 text-[13px] font-medium text-slate-light">{strings.read1Title}</h3>
    <ol class="mt-4 grid list-none gap-8 lg:grid-cols-3">
      {
        strings.read1.map((para) => (
          <li class="border-l-2 border-rule pl-4 text-[14.5px] leading-relaxed text-slate">
            {para}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="border-t border-rule py-12 sm:py-16">
    <h2 class="font-display text-[1.3rem] leading-snug font-semibold text-charcoal">
      {strings.fig2}
    </h2>
    <div class="mt-6">
      <GroupCurves lang={lang} rows={sex} ramp={SEX_RAMP} chartId="sex" height={400} />
    </div>
    <DataDownload lang={lang} files={["m3_sex"]} />

    <h3 class="mt-10 text-[13px] font-medium text-slate-light">{strings.read2Title}</h3>
    <p class="mt-4 max-w-3xl border-l-2 border-rule pl-4 text-[14.5px] leading-relaxed text-slate">
      {strings.read2}
    </p>
  </section>

  <section class="border-t border-rule py-12 sm:py-16">
    <h2 class="text-[13px] font-medium text-slate-light">{strings.notesTitle}</h2>
    <div class="mt-4 grid max-w-5xl gap-6 sm:grid-cols-3">
      {
        strings.notes.map((para) => (
          <p class="text-[13.5px] leading-relaxed text-slate-light">{para}</p>
        ))
      }
    </div>
  </section>

  <nav class="flex flex-wrap items-baseline justify-between gap-4 border-t border-rule py-8">
    <a href={SECTION_BASE[lang]} class="text-[14px] text-sky underline underline-offset-4">
      ← {strings.backLabel}
    </a>
    <a
      href={modulePath(next, lang)}
      class="text-[14px] text-sky underline underline-offset-4"
    >
      {strings.nextLabel}: {next.question[lang]} →
    </a>
  </nav>
</div>
