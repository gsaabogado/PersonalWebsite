---
import { getLangFromUrl, t } from "../../i18n/utils";
import { tools } from "../../data/tools";

const lang = getLangFromUrl(Astro.url);
---

<div class="space-y-6">
  {tools.map((tool, i) => (
    <a
      href={typeof tool.href === "string" ? tool.href : tool.href[lang]}
      data-animate
      data-delay={`${0.1 + i * 0.1}s`}
      class="group block bg-white rounded-xl p-8 border border-cool-gray hover:border-slate-light hover:shadow-md transition-all duration-300"
    >
      <span class="inline-block px-3 py-1 text-xs font-medium tracking-wide rounded-full mb-4 text-sky bg-sky/10">
        {tool.kind[lang]}
      </span>
      <h2 class="text-2xl font-heading font-bold text-charcoal group-hover:text-slate transition-colors mb-3">
        {tool.title[lang]}
      </h2>
      <p class="text-charcoal/70 leading-relaxed mb-4">{tool.description[lang]}</p>
      <p class="text-sm text-charcoal/50">{tool.audience[lang]} · {tool.date}</p>
      <span class="inline-flex items-center gap-2 mt-6 text-sm font-medium text-slate group-hover:text-sky transition-colors">
        {t(lang, "tools.open")}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    </a>
  ))}
</div>
