---
import ResearchHero from "../research/ResearchHero.astro";
import ToolList from "../tools/ToolList.astro";
import ThreadList from "./ThreadList.astro";
import { getLangFromUrl, t } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
---

<ResearchHero title={t(lang, "data.title")} description={t(lang, "data.description")} />
<section class="py-20 px-4 bg-warm-gray">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-heading font-bold text-charcoal mb-3">{t(lang, "data.threads")}</h2>
    <p class="text-charcoal/70 leading-relaxed mb-8">{t(lang, "data.threadsIntro")}</p>
    <ThreadList />
    <h2 class="text-3xl font-heading font-bold text-charcoal mt-20 mb-8">{t(lang, "data.tools")}</h2>
    <ToolList />
  </div>
</section>
